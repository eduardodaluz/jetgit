    "menus": {
      "editor/title": [
        {
          "command": "jetgit.changes.rollbackSelected",
          "group": "navigation@1",
          "when": "gitOpenRepositoryCount != 0 && isInDiffEditor && isInDiffRightEditor && resourceScheme == file && !isEmbeddedDiffEditor"
        }
      ],
      "view/title": [
        {
          "command": "jetgit.changelists.refresh",
          "group": "navigation@1",
          "when": "view == jetgitChangelists"
        },
        {
          "command": "jetgit.changelists.new",
          "group": "navigation@2",
          "when": "view == jetgitChangelists"
        },
        {
          "command": "jetgit.compare.withRef",
          "group": "navigation@1",
          "when": "view == jetgitCompare"
        },
        {
          "command": "jetgit.compare.clear",
          "group": "navigation@2",
          "when": "view == jetgitCompare && jetgitCompareActive"
        }
      ],
      "view/item/context": [
        {
          "command": "jetgit.changelists.commit",
          "group": "1_jet@1",
          "when": "view == jetgitChangelists && viewItem == changelist"
        },
        {
          "command": "jetgit.changelists.setActive",
          "group": "1_jet@2",
          "when": "view == jetgitChangelists && viewItem == changelist"
        },
        {
          "command": "jetgit.changelists.editComment",
          "group": "2_jet@1",
          "when": "view == jetgitChangelists && viewItem == changelist"
        },
        {
          "command": "jetgit.changelists.rename",
          "group": "2_jet@2",
          "when": "view == jetgitChangelists && viewItem == changelist"
        },
        {
          "command": "jetgit.changelists.delete",
          "group": "3_jet@1",
          "when": "view == jetgitChangelists && viewItem == changelist"
        },
        {
          "command": "jetgit.changelists.commitFiles",
          "group": "1_jet@1",
          "when": "view == jetgitChangelists && viewItem == changelistFile"
        },
        {
          "command": "jetgit.changes.rollbackFile",
          "group": "1_jet@2",
          "when": "view == jetgitChangelists && viewItem == changelistFile"
        },
        {
          "command": "jetgit.changelists.moveFiles",
          "group": "1_jet@3",
          "when": "view == jetgitChangelists && viewItem == changelistFile"
        },
        {
          "command": "jetgit.changes.openDiff",
          "group": "1_jet@4",
          "when": "view == jetgitChangelists && viewItem == changelistFile"
        },
        {
          "command": "jetgit.changes.openFile",
          "group": "1_jet@5",
          "when": "view == jetgitChangelists && viewItem == changelistFile"
        },
        {
          "command": "jetgit.merge.acceptYours",
          "group": "1_jet@1",
          "when": "view == jetgitChangelists && viewItem == mergeConflictFile"
        },
        {
          "command": "jetgit.merge.acceptTheirs",
          "group": "1_jet@2",
          "when": "view == jetgitChangelists && viewItem == mergeConflictFile"
        },
        {
          "command": "jetgit.merge.openMergeEditor",
          "group": "1_jet@3",
          "when": "view == jetgitChangelists && viewItem == mergeConflictFile"
        },
        {
          "command": "jetgit.merge.openFile",
          "group": "1_jet@4",
          "when": "view == jetgitChangelists && viewItem == mergeConflictFile"
        },
        {
          "command": "jetgit.merge.complete",
          "group": "1_jet@1",
          "when": "view == jetgitChangelists && viewItem == merge"
        },
        {
          "command": "jetgit.merge.abort",
          "group": "1_jet@2",
          "when": "view == jetgitChangelists && viewItem == merge"
        },
        {
          "command": "jetgit.shelf.shelve",
          "group": "4_jet@1",
          "when": "view == jetgitChangelists && viewItem == changelist"
        },
        {
          "command": "jetgit.shelf.saveToShelf",
          "group": "4_jet@2",
          "when": "view == jetgitChangelists && viewItem == changelist"
        },
        {
          "command": "jetgit.shelf.apply",
          "group": "1_jet@1",
          "when": "view == jetgitShelves && viewItem == shelf"
        },
        {
          "command": "jetgit.shelf.applyAndDelete",
          "group": "1_jet@2",
          "when": "view == jetgitShelves && viewItem == shelf"
        },
        {
          "command": "jetgit.shelf.rename",
          "group": "2_jet@1",
          "when": "view == jetgitShelves && viewItem == shelf"
        },
        {
          "command": "jetgit.shelf.delete",
          "group": "3_jet@1",
          "when": "view == jetgitShelves && viewItem == shelf"
        },
        {
          "command": "jetgit.compare.getFileFromRef",
          "group": "1_jet@1",
          "when": "view == jetgitCompare && viewItem == compareFile"
        }
      ],
      "editor/context": [
        {
          "command": "jetgit.changes.rollbackSelected",
          "group": "8_jetgit",
          "when": "gitOpenRepositoryCount != 0 && isInDiffEditor && isInDiffRightEditor && resourceScheme == file && !isEmbeddedDiffEditor"
        },
        {
          "submenu": "jetgit.localHistory",
          "group": "9_jetgit"
        }
      ],
      "jetgit.localHistory": [
        {
          "command": "jetgit.localHistory.showDiff"
        },
        {
          "command": "jetgit.localHistory.putLabel"
        },
        {
          "command": "jetgit.localHistory.restoreDeleted"
        }
      ],
      "commandPalette": [
        {
          "command": "jetgit.changelists.rename",
          "when": "false"
        },
        {
          "command": "jetgit.changelists.editComment",
          "when": "false"
        },
        {
          "command": "jetgit.changelists.delete",
          "when": "false"
        },
        {
          "command": "jetgit.changelists.setActive",
          "when": "false"
        },
        {
          "command": "jetgit.changelists.moveFiles",
          "when": "false"
        },
        {
          "command": "jetgit.changelists.commitFiles",
          "when": "false"
        },
        {
          "command": "jetgit.shelf.apply",
          "when": "false"
        },
        {
          "command": "jetgit.shelf.applyAndDelete",
          "when": "false"
        },
        {
          "command": "jetgit.shelf.rename",
          "when": "false"
        },
        {
          "command": "jetgit.shelf.delete",
          "when": "false"
        },
        {
          "command": "jetgit.blame.openCommit",
          "when": "false"
        },
        {
          "command": "jetgit.compare.getFileFromRef",
          "when": "false"
        },
        {
          "command": "jetgit.compare.openCommitFiles",
          "when": "false"
        },
        {
          "command": "jetgit.compare.openFileDiff",
          "when": "false"
        },
        {
          "command": "jetgit.compare.clear",
          "when": "false"
        },
        {
          "command": "jetgit.changes.openFile",
          "when": "false"
        },
        {
          "command": "jetgit.changes.toggleHunk",
          "when": "false"
        },
        {
          "command": "jetgit.merge.acceptYours",
          "when": "false"
        },
        {
          "command": "jetgit.merge.acceptTheirs",
          "when": "false"
        },
        {
          "command": "jetgit.merge.openMergeEditor",
          "when": "false"
        },
        {
          "command": "jetgit.merge.openFile",
          "when": "false"
        },
        {
          "command": "jetgit.merge.complete",
          "when": "false"
        },
        {
          "command": "jetgit.merge.abort",
          "when": "false"
        }
      ]
    },
    "submenus": [
      {
        "id": "jetgit.localHistory",
        "label": "Local History"
      }
    ],
    "configuration": {
      "title": "JetGit",
      "properties": {
        "jetgit.changelists.autoAssign": {
          "type": "boolean",
          "default": true,
          "description": "Assign newly modified files to the active changelist."
        },
        "jetgit.blame.mode": {
          "type": "string",
          "enum": [
            "off",
            "currentLine",
            "wholeFile"
          ],
          "default": "currentLine",
          "description": "Inline blame mode. The built-in Git blame decoration lives in the setting git.blame.editorDecoration.enabled."
        },
        "jetgit.blame.coloring": {
          "type": "boolean",
          "default": true,
          "description": "Color the blame annotation by author."
        },
        "jetgit.blame.format": {
          "type": "string",
          "default": "{author} · {date}",
          "description": "Annotation template. Placeholders: {author}, {date}, {sha}, {summary}."
        },
        "jetgit.blame.ignoreWhitespace": {
          "type": "boolean",
          "default": true,
          "description": "Ignore whitespace changes when computing blame."
        },
        "jetgit.blame.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "description": "Skip inline blame for files larger than this size."
        },
        "jetgit.localHistory.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Record file snapshots in Local History. Works without any Git repository."
        },
        "jetgit.localHistory.retentionDays": {
          "type": "number",
          "default": 5,
          "description": "Days to keep Local History snapshots."
        },
        "jetgit.localHistory.maxSnapshotsPerFile": {
          "type": "number",
          "default": 50,
          "description": "Maximum snapshots kept per file (labeled snapshots are always kept)."
        },
        "jetgit.localHistory.maxFileSizeKB": {
          "type": "number",
          "default": 2048,
          "description": "Skip snapshotting files larger than this size."
        },
        "jetgit.localHistory.debounceMs": {
          "type": "number",
          "default": 1000,
          "description": "Debounce interval before a changed file is snapshotted."
        },
        "jetgit.shelf.confirmApply": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before applying a shelf."
        },
        "jetgit.compare.maxCommitEntries": {
          "type": "number",
          "default": 200,
          "description": "Maximum commits listed per direction in a comparison."
        },
        "jetgit.changes.confirmRollback": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before rolling back changes to HEAD."
        },
        "jetgit.changes.maxFileSizeKB": {
          "type": "number",
          "default": 2048,
          "description": "Skip change review and rollback for files larger than this size."
        },
        "jetgit.log.level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "error"
          ],
          "default": "info",
          "description": "Log level for the JetGit output channel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check-types && npm run bundle",
    "check-types": "tsc --noEmit",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "bundle": "node esbuild.js --production",
    "build-tests": "node scripts/clean.mjs dist/test && node esbuild.js --test",
    "test:unit": "vitest run",
    "test:integration": "node scripts/kill-stale-test-hosts.mjs && npm run build-tests && node scripts/run-integration.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "@types/vscode": "1.140.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.3.0",
    "esbuild": "^0.25.0",
    "mocha": "^10.8.2",
    "ovsx": "^0.10.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
