{
  "name": "jetgit",
  "displayName": "JetGit",
  "description": "Changelists, shelves, local history, inline blame and branch compare for Git — a calmer, more capable source control workflow for VS Code.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "eduardodaluz",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardodaluz/jetgit"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "changelist",
    "shelf",
    "local history",
    "blame",
    "compare",
    "version control"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jetgit",
          "title": "JetGit",
          "icon": "./media/activitybar.svg"
        }
      ]
    },
    "views": {
      "jetgit": [
        {
          "id": "jetgitChangelists",
          "name": "Changelists"
        },
        {
          "id": "jetgitShelves",
          "name": "Shelves"
        },
        {
          "id": "jetgitCompare",
          "name": "Compare"
        }
      ]
    },
    "viewsWelcome": [
