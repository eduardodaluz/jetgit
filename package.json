      },
      {
        "command": "jetgit.changelists.rename",
        "title": "Rename Changelist",
        "category": "JetGit"
      },
      {
        "command": "jetgit.changelists.editComment",
        "title": "Edit Changelist Comment",
        "category": "JetGit"
      },
      {
        "command": "jetgit.changelists.delete",
        "title": "Delete Changelist",
        "category": "JetGit"
      },
      {
