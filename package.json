        "view": "jetgitCompare",
        "contents": "Compare your work with any branch, tag or commit.\n[Compare with Branch…](command:jetgit.compare.withRef)"
      },
      {
        "view": "jetgitChangelists",
        "contents": "Group your uncommitted changes into changelists. New changes join the active changelist.\n[New Changelist](command:jetgit.changelists.new)"
      }
    ],
    "commands": [
