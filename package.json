        "title": "Put Label",
        "category": "JetGit"
      },
      {
        "command": "jetgit.localHistory.restore",
        "title": "Restore from Local History",
        "category": "JetGit"
      },
      {
        "command": "jetgit.localHistory.restoreDeleted",
