        "category": "JetGit"
      },
      {
        "command": "jetgit.localHistory.clear",
        "title": "Clear Local History",
        "category": "JetGit"
      },
      {
        "command": "jetgit.localHistory.storageUsage",
        "title": "Local History Storage Usage",
        "category": "JetGit"
      },
      {
        "command": "jetgit.blame.setMode",
